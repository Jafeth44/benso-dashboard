rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/administradores/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/administradores/$(request.auth.token.email)).data.isAdmin == true;
    }

    // Managed manually in the Firebase console -- doc ID must be the
    // admin's sign-in email so isAdmin() above can look it up directly.
    match /administradores/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /equipos/{activo} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      // Non-admins may still log maintenance visits and update the
      // equipo photo, matching what the UI already lets them do --
      // everything else (client, address, model, etc.) is admin-only.
      allow update: if isAdmin() ||
        (request.auth != null &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['mantenimientos', 'proximoMantenimiento', 'foto', 'fotoRef']));
    }
  }
}
